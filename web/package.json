{
  "name": "dah-web",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "VITE_API_URL=http://127.0.0.1:8123 vite build --outDir dist-desktop --emptyOutDir",
